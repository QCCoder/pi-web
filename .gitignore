# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.factory

# loop runtime generated outputs
/outputs

# superpowers scratch reports (process artifacts, not repo content)
.superpowers/
# pi data home — relocated from ~/.pi via scripts/adopt-pi-home.mjs (.env.local
# points the three env vars at .pi/agent, .pi/workspaces, .pi/workspace-index.yaml).
# NEVER commit: contains auth tokens, importer credentials, session history,
# cloned repositories. (.pi/workspace.yaml manifest + workspace-templates stay tracked.)
/.pi/agent/
/.pi/workspaces/
/.pi/workspace-index.yaml
